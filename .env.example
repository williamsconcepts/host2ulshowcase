# ==============================================================================
# Host2uls Showcase Environment Configuration
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL="https://host2uls.com"

# Admin CMS Authentication
# Change these in production!
ADMIN_EMAIL="admin@host2uls.com"
ADMIN_PASSWORD="ChangeMeInProduction2025!"
JWT_SECRET="super-secret-jwt-key-replace-with-a-random-32-char-string-in-prod"

# Optional Cloud Storage for uploads (Fallback to local /public/uploads/ if empty)
# Vercel Blob:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Or Cloudinary:
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# Analytics Placeholders
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

